# 复制为 config.yaml，再在本地填写 api_key。
default_llm:
  class: langchain_deepseek.ChatDeepSeek
  params:
    api_key: YOUR_API_KEY_HERE
    model: deepseek-flash
    temperature: 0
    max_tokens: 4096

# 与原项目一致：Catalog 使用文件存储，Chroma 保存三组检索索引。
catalog_store:
  store_type: file_system
  data_path: catalog_data
vector_db_path: chroma_db

# 业务数据库。省略本段时使用 data/tracking_orders.sqlite。
database:
  type: sqlite
  path: data/tracking_orders.sqlite
# 切换到 PostgreSQL 时改为：
# database:
#   type: postgres
#   url_env: MINI_DATABASE_URL
# 并在启动前设置 MINI_DATABASE_URL（连接串只放在环境变量中）。
embedding_model:
  class: langchain_openai.OpenAIEmbeddings
  params:
    api_key: YOUR_EMBEDDING_API_KEY_HERE
    base_url: YOUR_OPENAI_COMPATIBLE_BASE_URL_HERE
    model: text-embedding-v4
    chunk_size: 10
    check_embedding_ctx_length: false

# Optional analysis: pip install -r requirements/analysis.txt
# Build: docker build -f Dockerfile.analysis -t betterchatbi-analysis:1 .
analysis:
  enabled: false
  model: null  # Same class/params shape as default_llm; null reuses the main model.
  evidence_dir: var/analysis
  image: betterchatbi-analysis:1
  timeout_seconds: 30
  cpus: 1
  memory_mib: 512
  pids: 64
  output_bytes: 20971520
  file_bytes: 10485760
  file_count: 32
  log_bytes: 65536
  max_query_rows: 10000
  max_query_bytes: 10485760
  max_tool_calls: 20
  max_model_calls: 20
  run_seconds: 180
  max_repairs: 2
  retention_days: 30
