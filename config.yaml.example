# 复制为 config.yaml，再在本地填写 api_key。
default_llm:
  class: langchain_deepseek.ChatDeepSeek
  params:
    api_key: YOUR_API_KEY_HERE
    model: deepseek-chat
    temperature: 0
    max_tokens: 1024

# 与原项目一致：Catalog 使用文件存储，Chroma 保存三组检索索引。
catalog_store:
  store_type: file_system
  data_path: catalog_data
vector_db_path: chroma_db

# 业务数据库。省略本段时使用 data/tracking_orders.sqlite。
database:
  type: sqlite
  path: data/tracking_orders.sqlite
# 切换到 PostgreSQL 时改为：
# database:
#   type: postgres
#   url_env: MINI_DATABASE_URL
# 并在启动前设置 MINI_DATABASE_URL（连接串只放在环境变量中）。
embedding_model:
  class: langchain_openai.OpenAIEmbeddings
  params:
    api_key: YOUR_EMBEDDING_API_KEY_HERE
    base_url: YOUR_OPENAI_COMPATIBLE_BASE_URL_HERE
    model: text-embedding-v4
    chunk_size: 10
    check_embedding_ctx_length: false
